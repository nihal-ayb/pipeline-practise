pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-cred'
        DOCKER_IMAGE          = 'nihalayb/maker-latest'
        SONAR_SERVER_NAME     = 'sonarqube-env'
        SONAR_SCANNER_TOOL    = 'sonar-scanner'
        GIT_CREDENTIALS_ID    = 'github-cred'
        MANIFEST_REPO         = 'https://github.com/nihal-ayb/pipeline-practise.git'
        MANIFEST_BRANCH       = 'main'
        MANIFEST_FILE         = 'maker/manifests/deployment.yaml'
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                //checkout scm
                echo 'passed'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool "${SONAR_SCANNER_TOOL}"
                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {
                        sh "${scannerHome}/bin/sonar-scanner \
                            -Dsonar.host.url=http://localhost:9000 \
                            -Dsonar.projectKey=maker-key \
                            -Dsonar.projectName='maker-project' \
                            -Dsonar.sources=."
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        // FIX: docker.build() builds the image; docker.image() only references an existing one
                        def appImage = docker.build( "${DOCKER_IMAGE}:${env.BUILD_NUMBER}","./maker")
                        appImage.push()
                        appImage.push('latest')
                    }
                }
            }
        }

        stage('Update Manifest Repo') {
            steps {
                dir('manifest-workspace') {
                    git branch: "${MANIFEST_BRANCH}",
                        credentialsId: "${GIT_CREDENTIALS_ID}",
                        url: "${MANIFEST_REPO}"

                    // FIX: the git step's credentials don't carry over to `sh`, so pass them explicitly.
                    // The github-cred password must be a GitHub Personal Access Token with repo write scope.
                    withCredentials([usernamePassword(
                            credentialsId: "${GIT_CREDENTIALS_ID}",
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_PASS')]) {
                        // Single quotes: secrets are expanded by the shell, not interpolated by Groovy
                        sh '''
                            set -e

                            if [ ! -f "$MANIFEST_FILE" ]; then
                                echo "ERROR: $MANIFEST_FILE not found in manifest repo"
                                exit 1
                            fi

                            # Replace the image line for this app, keeping its indentation
                            sed -i "s|image:.*${DOCKER_IMAGE}.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|" "$MANIFEST_FILE"

                            if git diff --quiet; then
                                echo "No manifest changes to commit."
                            else
                                git -c user.name="Jenkins CI" -c user.email="jenkins@ci.local" \
                                    commit -am "chore(manifest): update maker image tag to ${BUILD_NUMBER} [skip ci]"
                                git push "https://${GIT_USER}:${GIT_PASS}@${MANIFEST_REPO#https://}" "HEAD:${MANIFEST_BRANCH}"
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully! Manifest repo updated with new image tag.'
        }
        failure {
            echo 'Pipeline failed. Please review the stage logs above.'
        }
    }
}